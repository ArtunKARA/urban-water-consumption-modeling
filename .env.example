# Copy to .env for a separately provisioned environment. Never commit credentials.
# scripts/dev_database.py creates a private synthetic-only local development .env.
UW_ENV=synthetic
UW_DATABASE_URL=postgresql://urban_water:CHANGE_ME@127.0.0.1:55432/urban_water
UW_STORAGE_ROOT=var/synthetic
UW_TIMEZONE=Europe/Istanbul
UW_STUDY_CODE=synthetic-pilot
UW_COHORT_CODE=fixture
# Only needed for compose.yaml; use the same password in UW_DATABASE_URL.
UW_PG_PASSWORD=CHANGE_ME
UW_LEASE_SECONDS=60
UW_CHUNK_SIZE=1000
UW_MAX_ATTEMPTS=3
UW_MAX_SOURCE_BYTES=268435456
UW_MAX_LINE_BYTES=65536
UW_MAX_RECORDS=2000000
